# Copy this file to .env and fill in your real key.
# Do not commit .env to GitHub.

LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai-compatible-provider.example/v1
LLM_MODEL=your-model-name
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
# Optional HTTP/HTTPS proxy for LLM requests.
LLM_PROXY=http://127.0.0.1:7890
# Or use the standard env vars: HTTPS_PROXY / HTTP_PROXY
